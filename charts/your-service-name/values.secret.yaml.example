# =============================================================================
# Non-committed chart secrets (finding C-M1) — EXAMPLE ONLY.
# =============================================================================
# Copy this file to `values.secret.yaml` (which is gitignored — see .gitignore)
# and fill in real values, then layer it on deploy with an extra -f:
#
#   helm upgrade --install your-service-name charts/your-service-name \
#     -f charts/your-service-name/values.local.yaml \
#     -f charts/your-service-name/values.secret.yaml
#
# This is the local (and kind) source only: dev, qa and production take the app Secret from
# the External Secrets Operator, and the render refuses both at once (wiki/security.md,
# Secret sources). NEVER commit the real `values.secret.yaml`, and NEVER put real passwords
# in the committed values.*.yaml files.
#
# The DB password here is ALSO the password the internal Postgres initializes with
# (single source: secrets.dbPassword), so the app and the database always match —
# it is the one value to provide, not two.
secrets:
  dbUser: app
  dbPassword: "change-me-db-password"
  statsPass: "change-me-stats-password"

# Optional backend keys that can hold a credential belong in the app Secret, not in `config:`
# (the chart refuses them there). With the ExternalSecret, add each to secrets.externalSecret.keys and
# the store; with secrets.existingSecret, add them to that Secret:
#   RATE_LIMIT_STORAGE          rediss://:<password>@<host>:6379/0   (shared rate-limit counters)
#   OTEL_EXPORTER_OTLP_HEADERS  authorization=Bearer <token>         (OTLP collector auth)
