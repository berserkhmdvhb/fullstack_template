an api host adds a rule with the backend routes only:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      labels:
        app.kubernetes.io/instance: svc
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: your-service-name
        app.kubernetes.io/version: 1.0.0
        environment: dev
        helm.sh/chart: your-service-name-0.1.0
      name: svc-your-service-name
      namespace: app
    spec:
      rules:
        - host: your-service-name.your-domain.example
          http:
            paths:
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /api
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /docs
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /openapi.json
                pathType: Exact
              - backend:
                  service:
                    name: svc-your-service-name-frontend
                    port:
                      number: 3000
                path: /
                pathType: Prefix
        - host: svc-api.example.org
          http:
            paths:
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /api
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /docs
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /openapi.json
                pathType: Exact
derives the one host rule from the routes list:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      labels:
        app.kubernetes.io/instance: svc
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: your-service-name
        app.kubernetes.io/version: 1.0.0
        environment: dev
        helm.sh/chart: your-service-name-0.1.0
      name: svc-your-service-name
      namespace: app
    spec:
      rules:
        - host: your-service-name.your-domain.example
          http:
            paths:
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /api
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /docs
                pathType: Prefix
              - backend:
                  service:
                    name: svc-your-service-name-backend
                    port:
                      number: 8000
                path: /openapi.json
                pathType: Exact
              - backend:
                  service:
                    name: svc-your-service-name-frontend
                    port:
                      number: 3000
                path: /
                pathType: Prefix
