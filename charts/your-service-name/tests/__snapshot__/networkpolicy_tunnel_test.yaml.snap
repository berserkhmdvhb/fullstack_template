                matchLabels:
                  kubernetes.io/metadata.name: app-db
              podSelector:
                matchLabels:
                  app.kubernetes.io/component: postgresql
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
          to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
      podSelector:
        matchLabels:
          app.kubernetes.io/component: migration
      policyTypes:
        - Egress
