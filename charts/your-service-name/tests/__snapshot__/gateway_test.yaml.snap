an api host adds an HTTPRoute with the backend routes only:
  1: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      labels:
        app.kubernetes.io/instance: svc
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: your-service-name
        app.kubernetes.io/version: 1.0.0
        environment: dev
        helm.sh/chart: your-service-name-0.1.0
      name: svc-your-service-name-api
      namespace: app
    spec:
      hostnames:
        - svc-api.example.org
      parentRefs:
        - name: your-gateway
          namespace: gateway-system
      rules:
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: PathPrefix
                value: /api
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: PathPrefix
                value: /docs
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: Exact
                value: /openapi.json
the root host serves every route, in list order, and no other host renders:
  1: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      labels:
        app.kubernetes.io/instance: svc
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: your-service-name
        app.kubernetes.io/version: 1.0.0
        environment: dev
        helm.sh/chart: your-service-name-0.1.0
      name: svc-your-service-name-root
      namespace: app
    spec:
      hostnames:
        - your-service-name.your-domain.example
      parentRefs:
        - name: your-gateway
          namespace: gateway-system
      rules:
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: PathPrefix
                value: /api
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: PathPrefix
                value: /docs
        - backendRefs:
            - name: svc-your-service-name-backend
              port: 8000
          matches:
            - path:
                type: Exact
                value: /openapi.json
        - backendRefs:
            - name: svc-your-service-name-frontend
              port: 3000
          matches:
            - path:
                type: PathPrefix
                value: /
