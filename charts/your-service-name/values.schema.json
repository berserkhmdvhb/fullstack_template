{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "your-service-name chart values",
  "description": "Single source of truth for the shape of values.yaml (and every values.<env>.yaml, which merge onto it). Helm validates the MERGED values against this on `helm lint`/`helm template`, so a typo key or wrong type fails loudly instead of silently rendering the wrong thing.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "nameOverride":     { "type": "string", "description": "Replaces the chart name in chart.name and chart.fullname." },
    "fullnameOverride": { "type": "string", "description": "Replaces chart.fullname. Set the bootstrap's fullname to the same value (infra/k8s/bootstrap)." },

    "environment": {
      "description": "Deploy environment. Drives ENV, config, and which value-set is in force.",
      "type": "string",
      "enum": ["dev", "qa", "production", "local"]
    },

    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dbSuffix": { "type": "string" },
        "create":   { "type": "boolean" }
      }
    },

    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },

    "imagePullPolicy": { "type": "string" },

    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend":  { "$ref": "#/definitions/image" },
        "frontend": { "$ref": "#/definitions/image" },
        "waf":      { "$ref": "#/definitions/image" }
      }
    },

    "backend": {
      "description": "Backend-only settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraAllowedHosts": {
          "description": "Comma-separated Host values appended to the backend's ALLOWED_HOSTS.",
          "type": "string"
        },
        "extraInitContainers": {
          "description": "Init containers rendered first, before wait-for-db, in the backend Deployment and the migration Job.",
          "type": "array",
          "items": { "type": "object" }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraEgress": {
              "description": "NetworkPolicy egress rules appended to the backend's egress policy (an OTLP collector on 4318, a Redis on 6379).",
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    },

    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracing": {
          "description": "Opt-in OpenTelemetry tracing of the backend (OTLP/HTTP). The collector headers (OTEL_EXPORTER_OTLP_HEADERS) are a secret: put them in the app Secret.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":     { "type": "boolean" },
            "endpoint":    { "description": "The collector's base URL, for example http://collector:4318. Required when enabled.", "type": "string" },
            "sampleRatio": { "description": "Share of new traces recorded (0 to 1).", "type": "number", "minimum": 0, "maximum": 1 },
            "serviceName": { "description": "service.name; empty keeps the backend default.", "type": "string" }
          }
        }
      }
    },

    "cspReporting": {
      "description": "Opt-in CSP violation reports: turns on the backend endpoint (CSP_REPORT_ENABLED) and the frontend's reporting directives (CSP_REPORTING_ENABLED).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },

    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caSecret": {
              "description": "An existing Secret with the database CA certificate; mounted read-only and set as DB_SSLROOTCERT.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "key":  { "type": "string" }
              }
            }
          }
        }
      }
    },

    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend":  { "type": "integer", "minimum": 1 },
        "frontend": { "type": "integer", "minimum": 1 }
      }
    },

    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend":    { "$ref": "#/definitions/resources" },
        "frontend":   { "$ref": "#/definitions/resources" },
        "waitForDb":  { "$ref": "#/definitions/resources" },
        "migration":  { "$ref": "#/definitions/resources" },
        "postgresql": { "$ref": "#/definitions/resources" },
        "pgBackup":   { "$ref": "#/definitions/resources" },
        "tests":      { "$ref": "#/definitions/resources" }
      }
    },

    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSurge":                { "type": ["integer", "string"], "pattern": "^[1-9][0-9]*%?$", "minimum": 1 },
        "minReadySeconds":         { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },

    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preStopSeconds":       { "type": "integer", "minimum": 1 },
        "frontendDrainSeconds": { "type": "integer", "minimum": 1 },
        "marginSeconds":        { "type": "integer", "minimum": 1 }
      }
    },

    "config": {
      "description": "Non-secret config -> ConfigMap. Every value is a string (a ConfigMap is string-only), so any non-string here fails.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "dbUser":         { "type": "string" },
        "dbPassword":     { "type": "string" },
        "statsPass":      { "type": "string" },
        "externalSecret": {
          "description": "External Secrets Operator ExternalSecret that syncs the app Secret from the platform's secret store. One of three exclusive secret sources.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":         { "type": "boolean" },
            "refreshInterval": { "type": "string", "minLength": 1 },
            "secretStoreRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] }
              }
            },
            "remoteKeys": { "description": "Secret key -> remote key in the store.", "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },

    "cloudSqlProxy": {
      "description": "Cloud SQL Auth Proxy as a native sidecar in the backend Deployment and the migration Job. Off by default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":                { "type": "boolean" },
        "instanceConnectionName": { "type": "string" },
        "image":                  { "$ref": "#/definitions/image" },
        "privateIp":              { "type": "boolean" },
        "autoIamAuthn":           { "type": "boolean" },
        "runAsUser":              { "type": "integer", "minimum": 1 },
        "egressCIDRs":            { "type": "array", "items": { "type": "string" } },
        "healthPort":             { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metadataEgress": {
          "description": "GKE metadata server peers the proxy may reach, each a CIDR and its TCP ports.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr", "ports"],
            "properties": {
              "cidr":  { "type": "string", "minLength": 1 },
              "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
            }
          }
        },
        "resources":              { "$ref": "#/definitions/resources" }
      }
    },

    "edge": {
      "description": "How traffic reaches the Services: Gateway API HTTPRoutes, a plain Ingress, or a tunnel that renders nothing. One routes list feeds every mode.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["gateway", "tunnel", "ingress"] },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api":  { "type": "string", "minLength": 1 },
            "app":  { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 }
          }
        },
        "routes": {
          "description": "The one routes list. The root host serves every route, the api host the backend routes, the app host the frontend routes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "match", "service"],
            "properties": {
              "path":    { "type": "string", "pattern": "^/[^\\s]*$" },
              "match":   { "type": "string", "enum": ["PathPrefix", "Exact"] },
              "service": { "type": "string", "enum": ["backend", "frontend"] }
            }
          }
        },
        "namespaceSelector": {
          "description": "matchLabels of the namespace the edge runs in (tunnel: empty means cloudflared; ingress: required).",
          "$ref": "#/definitions/labels"
        },
        "extraPeers": {
          "description": "NetworkPolicy peers (ipBlock / namespaceSelector / podSelector) added to the edge allow in every mode.",
          "type": "array",
          "items": { "type": "object", "minProperties": 1 }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gke": {
              "description": "GKE Gateway provider policies (networking.gke.io/v1 HealthCheckPolicy and GCPBackendPolicy).",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled":        { "type": "boolean" },
                "timeoutSec":     { "type": "integer", "minimum": 1 },
                "logging": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sampleRate": { "type": "integer", "minimum": 0, "maximum": 1000000 }
                  }
                },
                "securityPolicy": { "type": "string" }
              }
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name":        { "type": "string" },
                  "namespace":   { "type": "string" },
                  "sectionName": { "type": "string" }
                }
              }
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request":        { "type": "string" },
                "backendRequest": { "type": "string" }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className":     { "type": "string" },
            "annotations":   { "type": "object", "additionalProperties": { "type": "string" } },
            "tlsSecretName": { "type": "string" }
          }
        },
        "tunnel": { "type": "object", "additionalProperties": false }
      }
    },

    "guards": {
      "description": "Deploy-time guards; the deploy script turns them on.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rejectPlaceholders": { "type": "boolean" }
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dns": {
          "description": "DNS egress peer: kube-dns by default, plus optional resolver ipBlocks (NodeLocal DNSCache).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": { "$ref": "#/definitions/labels" },
            "podSelector":       { "$ref": "#/definitions/labels" },
            "ipBlocks":          { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "monitoringNamespaceSelector": {
          "description": "matchLabels of the namespace allowed to scrape the backend's metrics port; empty follows monitoring.flavour (the monitoring namespace, or gmp-system for gmp), null drops the collector peer.",
          "oneOf": [ { "$ref": "#/definitions/labels" }, { "type": "null" } ]
        },
        "monitoringPodSelector": {
          "description": "matchLabels of the scraping Pods; empty follows monitoring.flavour (app.kubernetes.io/name: prometheus, or app.kubernetes.io/name: collector for gmp).",
          "$ref": "#/definitions/labels"
        },
        "migrationExtraEgress": {
          "description": "NetworkPolicy egress rules appended to the migration Job's egress policy.",
          "type": "array",
          "items": { "type": "object" }
        },
        "monitoringExtraPeers": {
          "description": "NetworkPolicy peers (from entries, for example an ipBlock for a node range) admitted to the metrics port only, next to the collector peer. Empty adds none.",
          "type": "array",
          "items": { "type": "object" }
        },
        "backendExtraIngressPeers": {
          "description": "NetworkPolicy peers (from entries) also admitted to the backend port, with the WAF on or off; for example the auth proxy in AUTH_MODE=gateway. Empty adds no rule.",
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },

    "waf": {
      "description": "In-cluster WAF (Coraza on Envoy wasm + OWASP CRS) fronting the API surface. Off by default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":    { "type": "boolean" },
        "provider":   { "type": "string", "enum": ["coraza"] },
        "owaspCrs":   { "type": "boolean" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "health": {
          "description": "The health listener the probes ask: a direct 200 on path, nothing else.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "upstream": {
          "description": "Where the WAF forwards; empty host and port mean the backend Service and port.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "type": "string", "pattern": "^([1-9][0-9]*)?$" }] }
          }
        },
        "timeouts": {
          "description": "Envoy's request_headers_timeout and request_timeout, in seconds.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestHeadersSeconds": { "type": "integer", "minimum": 1 },
            "requestSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "extraDirectives": {
          "description": "Coraza directives appended after CRS (rule exclusions).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "upstreamPeers": {
          "description": "NetworkPolicy peers (to entries) the WAF egress allows on the upstream port instead of the backend Pods.",
          "type": "array",
          "items": { "type": "object", "minProperties": 1 }
        },
        "upstreamIdleTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend":  { "$ref": "#/definitions/hpa" },
        "frontend": { "$ref": "#/definitions/hpa" }
      }
    },

    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend":  { "$ref": "#/definitions/minAvailable" },
        "frontend": { "$ref": "#/definitions/minAvailable" }
      }
    },

    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":     { "type": "boolean" },
        "image":       { "$ref": "#/definitions/image" },
        "clientImage": { "$ref": "#/definitions/image" },
        "existingSecret":    { "description": "Secret in the database namespace holding the server's password.", "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "size":       { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user":     { "type": "string" },
            "database": { "type": "string" }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean" },
            "schedule":      { "type": "string" },
            "retentionDays": { "type": "integer" },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "className": { "type": "string" },
                "size":       { "type": "string" }
              }
            }
          }
        }
      }
    },

    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":         { "type": "boolean" },
        "host":            { "type": "string" },
        "name":            { "type": "string" },
        "user":            { "type": "string" },
        "passwordSecret":  { "type": "string" },
        "egressCIDR":      { "type": "string" },
        "manageSecret":    { "type": "boolean" }
      }
    },

    "tests": {
      "description": "helm test (templates/tests): off by default; values.local.yaml and the kind job turn it on.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiPath": { "type": "string", "pattern": "^/" }
      }
    },

    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flavour": { "type": "string", "enum": ["prometheus-operator", "gmp"] },
        "gmp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterRules": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "enabled": { "type": "boolean" } }
            },
            "objectNamespaceLabel": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
          }
        },
        "scrapeAnnotations": { "type": "boolean" },
        "serviceMonitor":  { "type": "boolean" },
        "prometheusRule":  { "type": "boolean" },
        "prometheusRelease": { "type": "string" }
      }
    }
  },

  "required": ["environment"],

  "definitions": {
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "registry":   { "type": "string" },
        "digest":     { "description": "An immutable pin, sha256:<64 lower-case hex>; empty uses the tag. Production needs one on every image it renders (templates/validate-values.yaml).", "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },

    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/definitions/requestQuantities" },
        "limits":   { "$ref": "#/definitions/quantities" }
      }
    },

    "requestQuantities": {
      "allOf": [ { "$ref": "#/definitions/quantities" } ],
      "required": ["cpu", "memory"]
    },

    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu":               { "type": ["string", "integer", "number"] },
        "memory":            { "type": ["string", "integer"] },
        "ephemeral-storage": { "type": ["string", "integer"] }
      },
      "patternProperties": { "^hugepages-": { "type": ["string", "integer"] } }
    },

    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":     { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPU":   { "type": "integer" },
        "targetMemory": { "type": "integer" }
      }
    },

    "minAvailable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
