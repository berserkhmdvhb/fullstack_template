// Renovate owns every version update in this repository (Dependabot is limited to security updates:
// see .github/dependabot.yml). This file is inert until the Renovate GitHub App is installed on the repository.
//
// A Renovate pull request that bumps tools/pins.tsv or infra/security/config.yaml turns the `pins` check red
// on purpose: a maintainer runs `make pins-refresh` (checksums and hashed locks) and pushes. No bot writes
// checksums. The expected flow is in wiki/security.md. Keep this file to comments and plain JSON
// (quoted keys, no trailing commas): a test reads it with the standard library.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "UTC",

  // Pull request titles are Conventional Commits (.github/workflows/pr-title.yml), and the squash merge makes the
  // title the commit release-please reads. Every update is `fix(deps)`, a patch release: what an update changes ships
  // in the images or the chart, and the weekly group mixes those with CI-only bumps, so one type for all (a CI-only
  // week then cuts a patch release too, which is harmless). Never left to auto-detection, which may pick none.
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",

  // A release must be 7 days old before a pull request is opened; the pending check blocks any earlier merge.
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "customManagers": [
    {
      // tools/pins.tsv, rows whose url is a GitHub release asset or tag archive. Renovate replaces every occurrence of
      // the version inside the matched text, so the version column and the url move together. The match stops before
      // the sha256 column, which is not touched (make pins-refresh fills it in). (?m) because `^` must match at each line.
      "customType": "regex",
      "description": "tools/pins.tsv: GitHub-hosted tools",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9-]+)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://github\\.com/(?<packageName>[^/\\t]+/[^/\\t]+)/(?:releases/download|archive/refs/tags)/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "tools/pins.tsv: helm 3 and 4 (get.helm.sh)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>helm[34])\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://get\\.helm\\.sh/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      // kubectl (dl.k8s.io), and the Kubernetes OpenAPI spec at a release tag (k8s-openapi, the kubeconform schemas).
      "description": "tools/pins.tsv: kubectl (dl.k8s.io) and the Kubernetes OpenAPI spec",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>kubectl(?:-floor)?)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://dl\\.k8s\\.io/[^\\t]+)\\t",
        "(?m)^(?<depName>k8s-openapi)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://raw\\.githubusercontent\\.com/kubernetes/kubernetes/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      // The Kyverno Helm chart the kind admission test installs (data, like k8s-openapi).
      "description": "tools/pins.tsv: the Kyverno Helm chart (kyverno.github.io)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>kyverno-chart)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://kyverno\\.github\\.io/kyverno/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "helm",
      "packageNameTemplate": "kyverno",
      "registryUrlTemplate": "https://kyverno.github.io/kyverno"
    },
    {
      "customType": "regex",
      "description": "tools/pins.tsv: Node.js (nodejs.org)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>node)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://nodejs\\.org/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "node-version",
      "packageNameTemplate": "node"
    },
    {
      // Python tools (url uv:<package>): only the version column changes; make pins-refresh regenerates the hashed lock.
      // The `python` row is not a package: it is disabled below and bumped by hand.
      "customType": "regex",
      "description": "tools/pins.tsv: Python tools from PyPI",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9-]+)\\t(?<currentValue>[0-9][^\\t]*)\\tany\\tuv:(?<packageName>[^\\t]+)\\t-"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      // A line `# renovate: datasource=<datasource> depName=<package>` directly above `<key>: <version>` (config.yaml's
      // tool versions, and any version that is still inline in a workflow).
      "customType": "regex",
      "description": "Annotated versions in infra/security/config.yaml and the workflows",
      "managerFilePatterns": ["/^infra/security/config\\.yaml$/", "/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*[A-Za-z_-]+: [\"']?(?<currentValue>v?[0-9][^\\s\"']*)"
      ]
    },
    {
      // A line `# renovate: datasource=<datasource> depName=<package>` directly above `ARG <NAME>=<version>` in a root
      // Dockerfile (the Coraza Wasm release in Dockerfile.waf). Its sha256 ARG is not matched: the build fails the
      // checksum until a maintainer records the new asset's sha256.
      "customType": "regex",
      "description": "Annotated release versions in the Dockerfiles",
      "managerFilePatterns": ["/^Dockerfile\\.[a-z0-9-]+$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\nARG [A-Z0-9_]+=(?<currentValue>v?[0-9][^\\s]*)"
      ]
    },
    {
      // charts/your-service-name/ci/crds/sources.tsv: the upstream CRDs kubeconform's schemas are generated from, each a
      // GitHub release asset or a file at a v<version> tag. Only the version column and the url move; the sha256 column is
      // not matched (make pins-refresh writes it, the pins check fails until it does). Chart releases such as
      // helm-chart-X.Y.Z are not CRD versions: only vX.Y.Z tags count.
      "customType": "regex",
      "description": "ci/crds/sources.tsv: the pinned upstream CRDs",
      "managerFilePatterns": ["/^charts/[^/]+/ci/crds/sources\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9-]+)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<url>https://(?:github\\.com|raw\\.githubusercontent\\.com)/(?<packageName>[^/\\t]+/[^/\\t]+)/(?:releases/download/)?v[0-9][^\\t]*)\\t"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      // `repository:tag@sha256:...` written inline (config.yaml's DAST image, or an inline ref in a values file).
      "customType": "regex",
      "description": "Inline image digests in values files and config.yaml",
      "managerFilePatterns": ["/(^|/)values[^/]*\\.ya?ml$/", "/^infra/security/config\\.yaml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9][\\w.-]*(?:/[\\w.-]+)+):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The chart's split format: `repository:`, `tag:` and `digest:` on consecutive keys. It matches once `digest`
      // holds a sha256 (production); an empty digest is a local or placeholder image that has nothing to look up.
      "customType": "regex",
      "description": "Split repository/tag/digest image keys in values files",
      "managerFilePatterns": ["/(^|/)values[^/]*\\.ya?ml$/"],
      "matchStrings": [
        "repository: [\"']?(?<depName>[a-z0-9][\\w./-]*)[\"']?\\n\\s+tag: [\"']?(?<currentValue>[\\w][\\w.-]*)[\"']?(?:\\n\\s*(?:registry|#)[^\\n]*)*\\n\\s+digest: [\"']?(?<currentDigest>sha256:[a-f0-9]{64})[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The kind tests' throwaway images, each under a `# renovate: image=<name>` line: the Kyverno images in
      // deploy/policies/test/kyverno-values.yaml (the chart takes `tag: <tag>@<digest>`), the registry in
      // tests/k8s/_kube.py, and the collector and Redis in tests/k8s/test_tracing_redis.py (`<NAME>_TAG = `).
      "customType": "regex",
      "description": "Annotated image tags and digests of the kind tests",
      "managerFilePatterns": [
        "/^deploy/policies/test/kyverno-values\\.yaml$/",
        "/^tests/k8s/_kube\\.py$/",
        "/^tests/k8s/test_tracing_redis\\.py$/"
      ],
      "matchStrings": [
        "# renovate: image=(?<depName>[^\\s]+)[^\\n]*\\n\\s*(?:tag: |[A-Z]+_TAG = )\"(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],

  // uv.lock is maintained by Renovate's pep621 manager (part of config:recommended) with `uv lock`, which reads
  // [tool.uv] exclude-newer = "7 days" from pyproject.toml, so a refreshed lock also keeps the 7-day rule.
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "fix",
    "schedule": ["before 6am on monday"]
  },

  "packageRules": [
    {
      // Minor and patch updates (and digest refreshes) arrive together, once a week. Majors fall outside this rule,
      // so each one is its own pull request.
      "description": "Weekly group for minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "minor and patch updates",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Major updates: one pull request each, never grouped",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "addLabels": ["major"]
    },
    {
      // Lock file maintenance has no release timestamp, and minimumReleaseAge defaults to
      // minimumReleaseAgeBehaviour "timestamp-required" under internalChecksFilter "strict", so without this rule
      // no branch would ever be created. The 7 days are enforced inside uv.lock by [tool.uv] exclude-newer.
      "description": "uv.lock maintenance: no release timestamp to wait for (uv's exclude-newer holds the 7 days)",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      // Without a release timestamp the default timestamp-required behaviour holds the update; uv's exclude-newer still enforces the 7 days in the lock.
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // The uv pin in tools/pins.tsv and the uv image tag in Dockerfile.backend must stay equal (a test checks it),
      // so one pull request moves both. The image digest is refreshed by Renovate; the pins.tsv checksum by make pins-refresh.
      "description": "uv: the pins.tsv row and the backend image tag move together",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv"
    },
    {
      // The Kyverno CLI (the offline policy tests), the chart the kind admission test installs and that chart's
      // two images are one release (wiki/admission-control.md, Version pair): one pull request moves the CLI and
      // chart rows of tools/pins.tsv and the image tags and digests in deploy/policies/test/kyverno-values.yaml.
      // The pins.tsv checksums still come from make pins-refresh.
      "description": "Kyverno: the CLI pin, the chart pin and the chart's images move together",
      "matchPackageNames": ["kyverno/kyverno", "kyverno", "reg.kyverno.io/kyverno/kyverno", "reg.kyverno.io/kyverno/kyvernopre"],
      "groupName": "kyverno"
    },
    {
      // The WAF base (Dockerfile.waf) is tagged distroless-vX.Y.Z, which docker versioning cannot read: without this
      // rule only the digest of the same tag would be refreshed, and a new Envoy patch or minor never proposed.
      "description": "Envoy's distroless tags are versioned by their X.Y.Z",
      "matchPackageNames": ["envoyproxy/envoy"],
      "versioning": "regex:^distroless-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "pinDigests": true
    },
    {
      "description": "Tell the reviewer why pin drift is red",
      "matchFileNames": ["tools/pins.tsv", "infra/security/config.yaml", "charts/your-service-name/ci/crds/sources.tsv"],
      "prBodyNotes": ["The `pins` check is red until `make pins-refresh` has written the vendor checksums and the hashed locks. Run it and push."]
    },
    {
      // Helm 3 is only kept to prove the chart still renders on 3.x; Helm 4 is the default.
      "description": "helm3 stays on 3.x",
      "matchDepNames": ["helm3"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "allowedVersions": "<4"
    },
    {
      // The frontend's engines field is >=26 <27: a new Node major is a deliberate change (move the pins row, engines,
      // the version files and the Dockerfile images together). The cap covers every manager that tracks Node
      // (the pins row, .nvmrc, .node-version and the node image in the Dockerfiles), and one group keeps a Node
      // update in a single pull request. The distroless runtime image carries its major in its name
      // (nodejs26-debian13), so Renovate only refreshes its digest.
      "description": "node stays on 26.x in every file that names it",
      "matchPackageNames": ["node"],
      "matchManagers": ["custom.regex", "nvm", "nodenv", "dockerfile"],
      "allowedVersions": "/^26\\./",
      "groupName": "node"
    },
    {
      "description": "The python row names an interpreter, not a PyPI package (the backend base image is a Dockerfile, not this row)",
      "matchDepNames": ["python"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "enabled": false
    },
    {
      // Version-skew policy: kubectl stays within one minor of the cluster; change the pin when the cluster moves.
      "description": "kubectl follows the cluster, not the latest release",
      "matchDepNames": ["kubectl", "kubectl-floor"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      // The kubeconform schemas are the chart's kubeVersion floor (Chart.yaml): only its patches are proposed; move
      // the minor with the floor (a test keeps the two equal).
      "description": "k8s-openapi follows the chart's kubeVersion floor, not the latest release",
      "matchDepNames": ["k8s-openapi"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      // Last, so it overrides the per-dependency-type types that config:recommended's presets set.
      "description": "Every update's pull request title is fix(deps)",
      "matchPackageNames": ["*"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
