// Renovate owns every version update in this repository (Dependabot is limited to security updates:
// see .github/dependabot.yml). This file is inert until the Renovate GitHub App is installed on the repository.
//
// The developer toolchain is in mise.toml and mise.lock: Renovate's mise manager moves a version in mise.toml and runs
// `mise lock` for the lock, so the two change in one pull request and the `pins` check stays green. Four lines (helm3,
// helm4, kubectl, kubectl-floor) are moved by regex managers, which have no `mise lock` step: that pull request changes
// mise.toml only, and the `pins` check is red until `make pins-refresh` (or the weekly lock maintenance) writes the lock.
// Nothing here writes to a pull request branch: the jobs stay `contents: read`. What the mise manager needs, for
// an adopter: Renovate with mise 2026.7.12 or newer (it runs `mise lock` in safe mode, MISE_SAFE=1; an older mise, or
// none, makes it skip mise.lock, and then the `pins` check is red until a maintainer runs `make pins-refresh`), and its
// own GitHub token (`mise lock` makes about 50 API calls). The setting `"allowedUnsafeExecutions": ["mise"]` of a
// self-hosted Renovate lifts the safe mode; it is not needed and not advised. wiki/getting-started.md has the rest.
//
// A pull request that bumps tools/pins.tsv (mise itself, Python, the uv tools, two data rows) or
// infra/security/config.yaml turns the `pins` check red on purpose: a maintainer runs `make pins-refresh`
// (checksums and hashed locks) and pushes. No bot writes those checksums. The expected flow is in wiki/security.md.
// Keep this file to comments and plain JSON (quoted keys, no trailing commas): a test reads it with the standard library.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "UTC",

  // Pull request titles are Conventional Commits (.github/workflows/pr-title.yml), and the squash merge makes the
  // title the commit release-please reads. Every update is `fix(deps)`, a patch release: what an update changes ships
  // in the images or the chart, and the weekly group mixes those with CI-only bumps, so one type for all (a CI-only
  // week then cuts a patch release too, which is harmless). Never left to auto-detection, which may pick none.
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",

  // A release must be 7 days old before a pull request is opened; the pending check blocks any earlier merge.
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  // .devcontainer/devcontainer.json: the base image by tag and digest, the features by digest (docker:pinDigests). Named
  // here so it cannot be dropped silently; tests/supply_chain/test_devcontainer.py checks it.
  "devcontainer": { "enabled": true },

  "customManagers": [
    {
      // The tools that Renovate's mise manager cannot read in mise.toml: Helm's aqua recipe is an `http` package, and
      // helm3 and helm4 are aliases of one backend (each has its own version, so its own line). Renovate replaces the
      // version inside the matched text and runs no `mise lock` for a regex manager: the lock entry is written by
      // `make pins-refresh` (the pull request note below says so). (?m) because `^` must match at each line.
      "customType": "regex",
      "description": "mise.toml: helm 3 and 4 (github.com/helm/helm)",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["(?m)^(?<depName>helm[34]) = \"(?<currentValue>[0-9][^\"]*)\""],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      // kubectl (an `http` package in aqua too) and the floor alias: both versions are Kubernetes tags.
      "customType": "regex",
      "description": "mise.toml: kubectl and the floor kubectl (github.com/kubernetes/kubernetes)",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "(?m)^\"aqua:kubernetes/kubernetes/(?<depName>kubectl)\" = \"(?<currentValue>[0-9][^\"]*)\"",
        "(?m)^(?<depName>kubectl-floor) = \"(?<currentValue>[0-9][^\"]*)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      // tools/pins.tsv, the mise row (a GitHub release asset; one row per platform, both move together). Renovate
      // replaces every occurrence of the version inside the matched text, so the version column and the url move
      // together. The match stops before the sha256 column, which is not touched (make pins-refresh fills it in).
      // (?m) because `^` must match at each line. Only mise: every other tool is in mise.toml.
      "customType": "regex",
      "description": "tools/pins.tsv: mise itself (GitHub release)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>mise)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://github\\.com/(?<packageName>jdx/mise)/releases/download/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>[0-9].*)$"
    },
    {
      "customType": "regex",
      // The Kubernetes OpenAPI spec at a release tag (k8s-openapi, the kubeconform schemas); the kubectl pins are in mise.toml.
      "description": "tools/pins.tsv: the Kubernetes OpenAPI spec",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>k8s-openapi)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://raw\\.githubusercontent\\.com/kubernetes/kubernetes/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      // The Kyverno Helm chart the kind admission test installs (data, like k8s-openapi).
      "description": "tools/pins.tsv: the Kyverno Helm chart (kyverno.github.io)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>kyverno-chart)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://kyverno\\.github\\.io/kyverno/[^\\t]+)\\t"
      ],
      "datasourceTemplate": "helm",
      "packageNameTemplate": "kyverno",
      "registryUrlTemplate": "https://kyverno.github.io/kyverno"
    },
    {
      // The External Secrets Operator's Helm chart (data, like the Kyverno chart): the GKE guide and the kind test install it.
      "customType": "regex",
      "description": "tools/pins.tsv: the External Secrets Operator Helm chart (charts.external-secrets.io)",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>external-secrets-chart)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<platform>[^\\t]+)\\t(?<url>https://github\\.com/external-secrets/external-secrets/releases/download/helm-chart-[^\\t]+)\\t"
      ],
      "datasourceTemplate": "helm",
      "packageNameTemplate": "external-secrets",
      "registryUrlTemplate": "https://charts.external-secrets.io"
    },
    {
      // Python tools (url uv:<package>): only the version column changes; make pins-refresh regenerates the hashed lock.
      // The `python` row is not a package: it is disabled below and bumped by hand.
      "customType": "regex",
      "description": "tools/pins.tsv: Python tools from PyPI",
      "managerFilePatterns": ["/^tools/pins\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9-]+)\\t(?<currentValue>[0-9][^\\t]*)\\tany\\tuv:(?<packageName>[^\\t]+)\\t-"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      // A line `# renovate: datasource=<datasource> depName=<package>` directly above `<key>: <version>` (config.yaml's
      // tool versions, and any version that is still inline in a workflow).
      "customType": "regex",
      "description": "Annotated versions in infra/security/config.yaml and the workflows",
      "managerFilePatterns": ["/^infra/security/config\\.yaml$/", "/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*[A-Za-z_-]+: [\"']?(?<currentValue>v?[0-9][^\\s\"']*)"
      ]
    },
    {
      // A line `# renovate: datasource=<datasource> depName=<package>` directly above `ARG <NAME>=<version>` in a root
      // Dockerfile (the Coraza Wasm release in Dockerfile.waf). Its sha256 ARG is not matched: the build fails the
      // checksum until a maintainer records the new asset's sha256.
      "customType": "regex",
      "description": "Annotated release versions in the Dockerfiles",
      "managerFilePatterns": ["/^Dockerfile\\.[a-z0-9-]+$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\nARG [A-Z0-9_]+=(?<currentValue>v?[0-9][^\\s]*)"
      ]
    },
    {
      // charts/your-service-name/ci/crds/sources.tsv: the upstream CRDs kubeconform's schemas are generated from, each a
      // GitHub release asset or a file at a v<version> tag. Only the version column and the url move; the sha256 column is
      // not matched (make pins-refresh writes it, the pins check fails until it does). Chart releases such as
      // helm-chart-X.Y.Z are not CRD versions: only vX.Y.Z tags count.
      "customType": "regex",
      "description": "ci/crds/sources.tsv: the pinned upstream CRDs",
      "managerFilePatterns": ["/^charts/[^/]+/ci/crds/sources\\.tsv$/"],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9-]+)\\t(?<currentValue>[0-9][^\\t]*)\\t(?<url>https://(?:github\\.com|raw\\.githubusercontent\\.com)/(?<packageName>[^/\\t]+/[^/\\t]+)/(?:releases/download/)?v[0-9][^\\t]*)\\t"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      // `repository:tag@sha256:...` written inline (config.yaml's DAST image, or an inline ref in a values file).
      "customType": "regex",
      "description": "Inline image digests in values files and config.yaml",
      "managerFilePatterns": ["/(^|/)values[^/]*\\.ya?ml$/", "/^infra/security/config\\.yaml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9][\\w.-]*(?:/[\\w.-]+)+):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The chart's split format: `repository:`, `tag:` and `digest:` on consecutive keys. It matches once `digest`
      // holds a sha256 (production); an empty digest is a local or placeholder image that has nothing to look up.
      "customType": "regex",
      "description": "Split repository/tag/digest image keys in values files",
      "managerFilePatterns": ["/(^|/)values[^/]*\\.ya?ml$/"],
      "matchStrings": [
        "repository: [\"']?(?<depName>[a-z0-9][\\w./-]*)[\"']?\\n\\s+tag: [\"']?(?<currentValue>[\\w][\\w.-]*)[\"']?(?:\\n\\s*(?:registry|#)[^\\n]*)*\\n\\s+digest: [\"']?(?<currentDigest>sha256:[a-f0-9]{64})[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The kind tests' throwaway images, each under a `# renovate: image=<name>` line: the Kyverno images in
      // deploy/policies/test/kyverno-values.yaml (the chart takes `tag: <tag>@<digest>`), the registry in
      // tests/k8s/_kube.py, the collector and Redis in tests/k8s/test_tracing_redis.py and OpenBao in
      // tests/k8s/test_external_secrets.py (`<NAME>_TAG = `), and the operator's images in
      // deploy/external-secrets/external-secrets-values.yaml.
      "customType": "regex",
      "description": "Annotated image tags and digests of the kind tests",
      "managerFilePatterns": [
        "/^deploy/policies/test/kyverno-values\\.yaml$/",
        "/^tests/k8s/_kube\\.py$/",
        "/^tests/k8s/test_tracing_redis\\.py$/",
        "/^tests/k8s/test_external_secrets\\.py$/",
        "/^deploy/external-secrets/external-secrets-values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: image=(?<depName>[^\\s]+)[^\\n]*\\n\\s*(?:tag: |[A-Z]+_TAG = )\"(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The provenance line of .github/workflows/pr-agent.yml: the PR-Agent release (tag and commit) its image
      // corresponds to. Nothing runs it; it moves with the image in the pr-agent group below.
      "customType": "regex",
      "description": "The PR-Agent release commit beside its image",
      "managerFilePatterns": ["/^\\.github/workflows/pr-agent\\.yml$/"],
      "matchStrings": [
        "# The image corresponds to release (?<currentValue>v[0-9][^,\\s]*), commit (?<currentDigest>[0-9a-f]{40})\\."
      ],
      "depNameTemplate": "The-PR-Agent/pr-agent",
      "datasourceTemplate": "github-tags"
    }
  ],

  // mise.toml: the built-in mise manager reads the tool versions (aqua:, github: and core: entries) and, with the
  // lock file maintenance below, keeps mise.lock in step with a version bump. Only mise.toml is a config file here.
  "mise": { "enabled": true, "managerFilePatterns": ["/^mise\\.toml$/"] },

  // uv.lock is maintained by Renovate's pep621 manager (part of config:recommended) with `uv lock`, which reads
  // [tool.uv] exclude-newer = "7 days" from pyproject.toml, so a refreshed lock also keeps the 7-day rule. mise.lock is
  // maintained by the mise manager (`mise lock`); every version in mise.toml is exact, so it re-locks what is pinned.
  // The two pnpm-lock.yaml files are maintained by the npm manager with pnpm, which reads minimumReleaseAge (7 days)
  // from each project's pnpm-workspace.yaml, and every install checks the lock against it again.
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "fix",
    "schedule": ["before 6am on monday"]
  },

  "packageRules": [
    {
      // Minor and patch updates (and digest refreshes) arrive together, once a week. Majors fall outside this rule,
      // so each one is its own pull request.
      "description": "Weekly group for minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "minor and patch updates",
      "schedule": ["before 6am on monday"]
    },
    {
      // The devcontainer's feature is referenced by digest alone, with no tag beside it,
      // so Renovate has no version to compare and moves the digest to the feature's `latest` tag: its own pull
      // request, never in the weekly group, with a note to check what version that is.
      "description": "The devcontainer feature: its own pull request, the version checked by hand",
      "matchManagers": ["devcontainer"],
      "matchPackageNames": ["ghcr.io/devcontainers/features/docker-in-docker"],
      "groupName": null,
      "prBodyNotes": ["This digest follows the feature's `latest` tag. Check which version it is (a new major included) and read its release notes in the devcontainers/features repository before merging."]
    },
    {
      "description": "Major updates: one pull request each, never grouped",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "addLabels": ["major"]
    },
    {
      // Lock file maintenance has no release timestamp, and minimumReleaseAge defaults to
      // minimumReleaseAgeBehaviour "timestamp-required" under internalChecksFilter "strict", so without this rule
      // no branch would ever be created. The 7 days are enforced inside uv.lock by [tool.uv] exclude-newer and inside
      // each pnpm-lock.yaml by pnpm's minimumReleaseAge; mise.lock only locks the exact versions of mise.toml, which
      // Renovate wrote after the 7 days.
      "description": "uv.lock, pnpm-lock.yaml and mise.lock maintenance: no release timestamp to wait for (the 7 days are held where each is written)",
      "matchManagers": ["pep621", "npm", "mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      // Without a release timestamp the default timestamp-required behaviour holds the update; uv's exclude-newer still enforces the 7 days in the lock.
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // setuptools-scm and vcs-versioning are pinned twice in pyproject.toml: in the dev group (the release-tag test runs
      // setuptools_scm) and in [tool.uv] build-constraint-dependencies, with hashes; a test keeps the two equal. One pull
      // request moves both packages, majors too (this rule comes after the major rule). Whether Renovate also rewrites the
      // table-form build constraints is not verified, and it never writes their hashes: the note says what to check and do.
      "description": "setuptools-scm: the dev-group pins move with the build constraints",
      "matchPackageNames": ["setuptools-scm", "vcs-versioning"],
      "groupName": "setuptools-scm",
      "prBodyNotes": ["If this pull request did not change `setuptools-scm` and `vcs-versioning` in `[tool.uv] build-constraint-dependencies` in `pyproject.toml`, set them there to the versions it gives the dev group (a test fails until the two match). Then replace those entries' sha256 hashes with the new versions' files and run `make lock`, as wiki/getting-started.md (Build dependencies) describes."]
    },
    {
      // The uv pin in mise.toml (locked in mise.lock) and the uv image tag in Dockerfile.backend must stay equal (a test checks it),
      // so one pull request moves both. Renovate refreshes the image digest and runs `mise lock` for the checksums.
      "description": "uv: the mise.toml entry and the backend image tag move together",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv"
    },
    {
      // The Kyverno CLI (the offline policy tests), the chart the kind admission test installs and that chart's
      // two images are one release (wiki/admission-control.md, Version pair): one pull request moves the CLI and
      // chart pins (the CLI in mise.toml and mise.lock, the chart row in tools/pins.tsv) and the image tags and digests in deploy/policies/test/kyverno-values.yaml.
      // The chart row's checksum still comes from make pins-refresh (the CLI's from `mise lock`).
      "description": "Kyverno: the CLI pin, the chart pin and the chart's images move together",
      "matchPackageNames": ["kyverno/kyverno", "kyverno", "ghcr.io/kyverno/kyverno", "ghcr.io/kyverno/kyvernopre"],
      "groupName": "kyverno"
    },
    {
      // The External Secrets Operator is one release: its chart (tools/pins.tsv), its image (deploy/external-secrets/
      // external-secrets-values.yaml) and the CRDs kubeconform validates against (charts/your-service-name/ci/crds/sources.tsv)
      // move in one pull request. The chart row's checksum and the CRD schemas still come from make pins-refresh and make crd-schemas.
      "description": "External Secrets: the chart pin, its image and the CRD source move together",
      "matchPackageNames": ["external-secrets", "external-secrets/external-secrets", "ghcr.io/external-secrets/external-secrets"],
      "groupName": "external-secrets"
    },
    {
      // scorecard.yml stays on v2.5.0: v2.6.0's image cannot be pulled (ossf/scorecard-action#1752). Any later release is proposed.
      "description": "ossf/scorecard-action: never v2.6.0, whose image cannot be pulled (ossf/scorecard-action#1752)",
      "matchPackageNames": ["ossf/scorecard-action"],
      "allowedVersions": "!/^v?2\\.6\\.0$/"
    },
    {
      // The WAF base (Dockerfile.waf) is tagged distroless-vX.Y.Z, which docker versioning cannot read: without this
      // rule only the digest of the same tag would be refreshed, and a new Envoy patch or minor never proposed.
      "description": "Envoy's distroless tags are versioned by their X.Y.Z",
      "matchPackageNames": ["envoyproxy/envoy"],
      "versioning": "regex:^distroless-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "pinDigests": true
    },
    {
      // .github/workflows/pr-agent.yml runs the PR-Agent image by tag and digest (docker://, the github-actions manager).
      // Only the `<X.Y.Z>-github_action` tags are versions: the rolling `github_action` tag and the other image variants
      // are never proposed. Read the release notes: a new version can change what is sent to the model provider.
      "description": "PR-Agent's GitHub Action image follows its X.Y.Z-github_action tags",
      "matchPackageNames": ["pragent/pr-agent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-github_action$",
      "pinDigests": true
    },
    {
      // One pull request moves the image and the release line beside it.
      "description": "PR-Agent: the image and its release commit move together",
      "matchPackageNames": ["pragent/pr-agent", "The-PR-Agent/pr-agent"],
      "groupName": "pr-agent"
    },
    {
      // The documentation site (docs-site/package.json, exact pins): Starlight follows Astro's releases and its
      // plugins follow Starlight, so one pull request moves them, majors too (this rule comes after the major rule).
      "description": "The docs site: Astro, Starlight and the Starlight plugins move together",
      "matchFileNames": ["docs-site/package.json"],
      "matchPackageNames": ["astro", "@astrojs/**", "starlight-*"],
      "groupName": "astro and starlight"
    },
    {
      // The docs site renders its diagrams and runs axe in the frontend's Playwright Chromium: the two lockfiles pin
      // the same Playwright (tests/docs_site/ checks it), so one pull request moves both.
      "description": "Playwright: the frontend and the docs site move together",
      "matchFileNames": ["frontend/package.json", "docs-site/package.json"],
      "matchPackageNames": ["playwright", "@playwright/test"],
      "groupName": "playwright"
    },
    {
      // pnpm is named three times: mise.toml (the tool, with its checksums in mise.lock) and packageManager in both
      // package.json files; Dockerfile.frontend's copy follows mise.lock through `make pins-refresh`.
      "description": "pnpm: mise.toml and both packageManager fields move together",
      "matchPackageNames": ["pnpm", "aqua:pnpm/pnpm"],
      "groupName": "pnpm",
      "prBodyNotes": ["Run `make pins-refresh` (it writes `mise.lock` and the pnpm version and checksums in `Dockerfile.frontend`), then `pnpm install --lockfile-only` in `frontend/` and `docs-site/` so each `pnpm-lock.yaml` records the new pnpm, and push."]
    },
    {
      "description": "mise.toml: the lock moves with the version, or the pins check says so",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "prBodyNotes": ["`mise.lock` should change in this pull request too (Renovate runs `mise lock`). If it did not, the `pins` check is red: run `make pins-refresh` and push."]
    },
    {
      // These four lines are moved by the regex managers, which cannot run `mise lock`.
      "description": "helm and kubectl in mise.toml: the lock is written by hand",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["mise.toml"],
      "matchDepNames": ["helm3", "helm4", "kubectl", "kubectl-floor"],
      "prBodyNotes": ["This pull request changes `mise.toml` only: Renovate does not run `mise lock` for this line. The `pins` check is red until you run `make pins-refresh` and push `mise.lock`."]
    },
    {
      "description": "Tell the reviewer why pin drift is red",
      "matchFileNames": ["tools/pins.tsv", "infra/security/config.yaml", "charts/your-service-name/ci/crds/sources.tsv"],
      "prBodyNotes": ["The `pins` check is red until `make pins-refresh` has written the vendor checksums and the hashed locks. Run it and push."]
    },
    {
      // Helm 3 is only kept to prove the chart still renders on 3.x; Helm 4 is the default.
      "description": "helm3 stays on 3.x",
      "matchDepNames": ["helm3"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["mise.toml"],
      "allowedVersions": "<4"
    },
    {
      // The frontend's engines field is >=26 <27: a new Node major is a deliberate change (move the mise.toml entry, engines,
      // the version files and the Dockerfile images together). The cap covers every manager that tracks Node
      // (mise.toml, .nvmrc, .node-version and the node image in the Dockerfiles), and one group keeps a Node
      // update in a single pull request. The distroless runtime image carries its major in its name
      // (nodejs26-debian13), so Renovate only refreshes its digest.
      "description": "node stays on 26.x in every file that names it",
      "matchPackageNames": ["node"],
      "matchManagers": ["mise", "nvm", "nodenv", "dockerfile"],
      "allowedVersions": "/^26\\./",
      "groupName": "node"
    },
    {
      "description": "The python row names an interpreter, not a PyPI package (the backend base image is a Dockerfile, not this row)",
      "matchDepNames": ["python"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "enabled": false
    },
    {
      // Version-skew policy: kubectl stays within one minor of the cluster; change the pin when the cluster moves.
      "description": "kubectl follows the cluster, not the latest release",
      "matchDepNames": ["kubectl", "kubectl-floor"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["mise.toml"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      // The kubeconform schemas are the chart's kubeVersion floor (Chart.yaml): only its patches are proposed; move
      // the minor with the floor (a test keeps the two equal).
      "description": "k8s-openapi follows the chart's kubeVersion floor, not the latest release",
      "matchDepNames": ["k8s-openapi"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools/pins.tsv"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      // The regex managers above own these four lines; the mise manager must not also propose them.
      "description": "The mise manager leaves helm and kubectl to the regex managers",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "matchDepNames": ["helm3", "helm4", "kubectl-floor", "aqua:kubernetes/kubernetes/kubectl"],
      "enabled": false
    },
    {
      // lychee's aqua recipe reads its tags as `lychee-v<version>` (its library crate has `lychee-lib-v…` tags, which
      // are not versions of the CLI).
      "description": "lychee: tags are lychee-v<version>",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "matchDepNames": ["aqua:lycheeverse/lychee"],
      "extractVersion": "^lychee-v(?<version>[0-9].*)$"
    },
    {
      // Last, so it overrides the per-dependency-type types that config:recommended's presets set.
      "description": "Every update's pull request title is fix(deps)",
      "matchPackageNames": ["*"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
