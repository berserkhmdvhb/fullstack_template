// Optional development container (wiki/getting-started.md, Development container). Every tool, Python and Node
// included, comes from tools/pins.tsv through `make tools`, checksum-verified: nothing here restates a version.
// The base is the kind job's runner OS (.github/workflows/reusable-kind.yml, runs-on). apt adds only what the
// installer itself needs (make, and a python3 >= 3.12 to unpack archives safely). Docker-in-Docker gives kind a daemon
// of its own inside the container; the feature runs the container privileged. Renovate's devcontainer manager moves
// the image and feature digests.
// linux/amd64 only: scripts/tools.sh installs for Linux-x86_64 and Darwin-arm64, so on Apple Silicon run the tools
// natively on macOS (make tools) instead.
// .tools and .venv are volumes of this container, not the workspace's: the installer links absolute paths, so sharing
// them with the host would break the host's toolchain (and the host's would break this one).
// Only whole-line comments: tests/supply_chain/test_devcontainer.py reads this file with the standard library.
{
  "name": "your-service-name",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.13-noble@sha256:48be4adec1c1ecbe030064700aef85382f5205786a8f82937fc44a7473717eae",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {}
  },
  "mounts": [
    "source=tools-${devcontainerId},target=${containerWorkspaceFolder}/.tools,type=volume",
    "source=venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume"
  ],
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.tools/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" .tools .venv && sudo apt-get update && sudo apt-get install -y --no-install-recommends make python3 && make tools"
}
