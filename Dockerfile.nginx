# your-service-name — adaptable service template (see wiki/getting-started.md)
# Nginx — Static Assets
# ===================================================================

# ---------------------------------------------------------------------------
# STAGE 1: Build the frontend ONCE.
#
# Next.js emits content-hashed bundles under .next/static/<buildId>/…; the HTML
# the frontend pod renders references those exact hashes. Nginx must serve the
# *same* files, so both images are built from a single `next build` here rather
# than two independent builds (which could drift). This stage produces the
# build; the runtime stage below copies its static output.
# ---------------------------------------------------------------------------
FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS frontend-builder

WORKDIR /app

# `next build` needs the TypeScript toolchain (a devDependency); `NODE_ENV=production`
# would make `npm ci` omit devDeps, so include them here too (same fix as
# Dockerfile.frontend) — otherwise the prod-only install leaves typescript out and
# the build fails. Also skip the Playwright browser download the build never uses.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Install dependencies (devDeps included — see note above)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --include=dev

# Copy source and build
COPY frontend/ ./
RUN npx next build

# The nginx image only needs the static output — verify it exists before we
# hand it off, so a broken build fails the image build, not the browser.
RUN test -d .next/static && test -d public


# ===================================================================
# STAGE 2: Runtime
# ===================================================================
FROM nginx:1-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72 AS runtime

# ---- Metadata ----
ARG VERSION=0.0.0
ARG VCS_REF=unknown
ARG VCS_BRANCH=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Your Service Name — Nginx" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.ref.name="${VCS_BRANCH}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.vendor="YourOrg" \
      org.opencontainers.image.url="https://your-domain.example/" \
      org.opencontainers.image.authors="YourOrg"

# Refresh the whole Alpine base to its latest patched packages (bare `apk upgrade`,
# not `apk add --upgrade <pkgs>`, which leaves libexpat/libxslt/zlib at the base's
# own versions). Base is Alpine 3.24: the fixes those CVEs need — zlib 1.4-r0,
# libexpat 2.10.0-r0, libxslt 1.1.43-r4 — are MAJOR-version bumps Alpine ships only in
# a new release, so Alpine 3.23 (EOL) can never carry them. `nginx:1.29-alpine` is
# stranded on Alpine 3.23 and no longer rebuilt, so the base moves to `nginx:1-alpine`
# (current mainline, nginx 1.31.x) on Alpine 3.24 — pinned by digest for reproducibility;
# bump the digest to pull a newer mainline + base as they age.
# hadolint ignore=DL3018 # apk versions are not pinnable per package; the base image digest pins the release
RUN apk update && apk upgrade --no-cache && apk add --no-cache brotli-libs curl

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Create non-root user
RUN addgroup -S -g 10001 nginxuser && adduser -S -u 10001 -G nginxuser nginxuser

# Copy custom nginx config as a TEMPLATE (rendered by entrypoint.sh at start).
# nginx does not expand env vars in its config, so ${NGINX_BIND}/${NGINX_PORT}/
# ${FRONTEND_ROOT} are substituted at container start, not baked in.
COPY --chown=nginxuser:nginxuser infra/nginx/nginx.conf /etc/nginx/nginx.conf.template

# Entrypoint renders the template (envsubst) then execs nginx.
COPY --chown=nginxuser:nginxuser infra/nginx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy frontend static assets from the build stage above — BOTH the Next.js
# build-time bundles and the public files, from the SAME build. This is the
# piece the template was missing: without .next/static, nginx 404s every CSS/JS
# bundle the SSR HTML references, so the page renders unstyled and unhydrated.
#
#   /_next/static/…  -> ${FRONTEND_ROOT}/.next/static/   (nginx.conf location /_next/static/)
#   /logo.png,/favicon.ico,… -> ${FRONTEND_ROOT}/…      (nginx.conf allow-listed locations)
COPY --from=frontend-builder --chown=nginxuser:nginxuser /app/.next/static /usr/share/nginx/html/.next/static
COPY --from=frontend-builder --chown=nginxuser:nginxuser /app/public /usr/share/nginx/html

# Ensure nginxuser can read/write needed dirs
RUN chown -R nginxuser:nginxuser /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
 && touch /var/run/nginx.pid && chown nginxuser:nginxuser /var/run/nginx.pid

# Healthcheck — uses HTTPS when HEALTHCHECK_SCHEME=https
ARG HEALTHCHECK_SCHEME=http
ENV HEALTHCHECK_SCHEME="${HEALTHCHECK_SCHEME:-http}"
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "curl -fsS \"${HEALTHCHECK_SCHEME}://localhost:${NGINX_PORT:-8081}/healthz\" || exit 1"]

EXPOSE 8081

USER 10001

CMD ["/entrypoint.sh"]
