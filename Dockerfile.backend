# your-service-name — adaptable service template (see wiki/getting-started.md)
# Backend — FastAPI/Uvicorn
# ===================================================================

#################################
# STAGE 1: Build
#################################
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS py-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

ARG PKG_VERSION=0.0.0

# Pretend version for setuptools_scm (no .git needed)
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_YOUR_SERVICE_NAME=${PKG_VERSION}

# Build deps (kept only in builder)
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md alembic.ini /app/
COPY src /app/src

# Install backend into /install
RUN pip install --upgrade pip \
 && pip install --no-cache-dir --prefix=/install .


############################
# STAGE 2: Runtime
############################
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS runtime

# ---- Metadata ----
ARG VERSION=0.0.0
ARG VCS_REF=unknown
ARG VCS_BRANCH=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Your Service Name — Backend" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.ref.name="${VCS_BRANCH}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.vendor="YourOrg" \
      org.opencontainers.image.url="https://your-domain.example/" \
      org.opencontainers.image.authors="YourOrg"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Runtime deps
RUN set -eux; \
    apt-get update -y; \
    apt-get install -y --no-install-recommends \
      libsqlite3-0 \
      libpq5 \
      bash \
      tini \
      curl \
      ca-certificates; \
    # Upgrade the OS packages the pinned slim base still ships below their published
    # security fix, so the grype gate stays clean without ignore entries: libpq5
    # 17.11 -> 17.12 and zlib1g 1:1.3.dfsg+really1.3.1-1+b1 -> -1+deb13u1 are pulled
    # from debian-security; apt/libapt-pkg7.0 3.0.3 -> 3.0.4 comes from the base bump.
    # Debian backports these into trixie, so --only-upgrade reaches them — unlike
    # Alpine, whose equivalent fixes are major-version bumps needing a new release
    # (that is why the nginx base is bumped, not --only-upgrade'd; see Dockerfile.nginx).
    apt-get install -y --no-install-recommends --only-upgrade libbrotli1 libpq5 zlib1g; \
    rm -rf /var/lib/apt/lists/*

# Pin pip to a vuln-fixed release (the slim base can ship an older pip; the
# 6 pip findings — path traversal, entry-point traversal, doubly-encoded URLs —
# are fixed in pip >= 25.3).
RUN python -m pip install --no-cache-dir --upgrade "pip>=25.3"

# Non-root user
RUN useradd -m -u 10001 appuser

WORKDIR /app

# Install backend (includes alembic.ini + migrations via pip install)
COPY --chown=10001:10001 --from=py-builder /install /usr/local

# Copy alembic.ini (needed at runtime for migrations)
COPY --chown=10001:10001 alembic.ini /app/alembic.ini

# Infra scripts
COPY --chown=10001:10001 infra/db/run_migrations.sh /app/infra/db/run_migrations.sh
COPY --chown=10001:10001 infra/backend/run_backend.sh /app/infra/backend/run_backend.sh
RUN chmod +x /app/infra/db/run_migrations.sh /app/infra/backend/run_backend.sh

# Logs dir
RUN mkdir -p /app/logs && chown -R appuser:appuser /app

# Healthcheck — uses HTTPS when HEALTHCHECK_SCHEME=https
ARG HEALTHCHECK_SCHEME=http
ENV HEALTHCHECK_SCHEME="${HEALTHCHECK_SCHEME:-http}"
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS "${HEALTHCHECK_SCHEME}://localhost:${BACKEND_PORT:-8000}/api/${API_VERSION:-v1}/healthz" || exit 1

USER appuser
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["/app/infra/backend/run_backend.sh"]
