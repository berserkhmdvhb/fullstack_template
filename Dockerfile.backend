# your-service-name — adaptable service template (see wiki/getting-started.md)
# Backend — FastAPI/Uvicorn
# ===================================================================

#################################
# STAGE 0: The runtime base, declared once
#################################
# Distroless Python (Debian 13, Python 3.13): no shell, no package manager, no pip. The builder takes
# its passwd and group files from this stage, and the final stage starts from it, so the digest below
# is the only copy. The builder is Debian 13 too, so the venv's interpreter link
# (/usr/bin/python3.13) is the same Debian interpreter in both stages.
FROM gcr.io/distroless/python3-debian13@sha256:60faad2efce94a847f32e2adbcaefeb2e4fd3e3a78075a3abb600904a5e010e9 AS runtime-base

#################################
# Debian fixes the runtime base has not shipped yet
#################################
# Each <package>=<version> is fetched from the Debian archive and the runtime stage copies it over the
# base; the build refuses an entry the base already has (scripts/docker/debian-fixes.sh). Empty is the
# usual state; when to add or remove one: wiki/containerization.md#debian-fixes-the-base-has-not-shipped-yet.
FROM debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS debian-fixes
# glibc: CVE-2026-19499 and CVE-2026-5435 (High), fixed in 2.41-12+deb13u5.
# MIT Kerberos: CVE-2026-112314, CVE-2026-112320, CVE-2026-112321, CVE-2026-112322, CVE-2026-112323 and
# CVE-2026-119079 (High), fixed in 1.21.3-5+deb13u2 (its four libraries, which depend on each other's version).
ARG DEBIAN_FIXES="libc6=2.41-12+deb13u5 libc-bin=2.41-12+deb13u5 libkrb5-3=1.21.3-5+deb13u2 libgssapi-krb5-2=1.21.3-5+deb13u2 libk5crypto3=1.21.3-5+deb13u2 libkrb5support0=1.21.3-5+deb13u2"
COPY --from=runtime-base / /base-root/
COPY scripts/docker/debian-fixes.sh /usr/local/bin/debian-fixes
RUN debian-fixes /base-root /out

#################################
# STAGE 1: Build
#################################
FROM debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS py-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3.13 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON_PREFERENCE=only-system

# uv from the official image, at the version mise.toml pins (a test keeps the two equal).
COPY --from=ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 /uv /bin/uv

# The Debian interpreter the runtime base uses, and tini (copied into the runtime below).
# hadolint ignore=DL3008 # apt versions are not pinnable per package; the base image digest pins the release
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      python3.13 \
      tini \
    && rm -rf /var/lib/apt/lists/*

# What the runtime stage copies in (it has no shell to make any of this):
# - tini's dpkg record and licence, so an SBOM scan lists it the way it lists distroless's own packages;
# - passwd and group with the app user (UID/GID 10001) added to the base's entries;
# - the home directory and the two directories the app writes.
RUN mkdir -p /out/dpkg-status.d /out/etc /out/home/appuser /out/app/data \
    && dpkg-query -s tini > /out/dpkg-status.d/tini
COPY --from=runtime-base /etc/passwd /etc/group /out/etc/
RUN echo 'appuser:x:10001:10001::/home/appuser:/sbin/nologin' >> /out/etc/passwd \
    && echo 'appuser:x:10001:' >> /out/etc/group

# The venv is built at /app/.venv and copied to the same path in the runtime stage, so its scripts and
# interpreter link (/usr/bin/python3.13) stay valid.
WORKDIR /app

# Layer 1: the locked dependencies only (cached until pyproject.toml or uv.lock changes).
# --frozen installs exactly uv.lock and checks every download against its recorded hash.
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev --no-install-project --no-editable

# Layer 2: the project itself.
ARG PKG_VERSION=0.0.0
# Pretend version for setuptools_scm (no .git needed)
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_YOUR_SERVICE_NAME=${PKG_VERSION}
COPY README.md LICENSE alembic.ini /app/
COPY src /app/src
RUN uv sync --frozen --no-dev --no-editable


############################
# STAGE 2: Runtime
############################
FROM runtime-base AS runtime

# The Debian fixes first, so every later layer sits on the fixed base.
COPY --from=debian-fixes /out/ /

# ---- Metadata ----
ARG VERSION=0.0.0
ARG VCS_REF=unknown
ARG VCS_BRANCH=unknown
ARG BUILD_DATE=unknown
# The repository the image belongs to; GHCR links the package to it. CI passes the real URL.
ARG SOURCE_URL=https://github.com/your-org/your-repo

LABEL org.opencontainers.image.title="Your Service Name — Backend" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.ref.name="${VCS_BRANCH}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.vendor="YourOrg" \
      org.opencontainers.image.url="https://your-domain.example/" \
      org.opencontainers.image.authors="YourOrg"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# tini (PID 1) from the Debian package; it links only glibc, which the base ships. Its dpkg record and
# licence go where the base keeps its own, so SBOM scanners list it.
COPY --from=py-builder /usr/bin/tini /usr/bin/tini
COPY --from=py-builder /out/dpkg-status.d/tini /var/lib/dpkg/status.d/tini
COPY --from=py-builder /usr/share/doc/tini/copyright /usr/share/doc/tini/copyright

# The app user: a passwd and group entry (UID/GID 10001) and its home.
COPY --from=py-builder /out/etc/passwd /out/etc/group /etc/
COPY --from=py-builder --chown=10001:10001 /out/home/appuser /home/appuser

WORKDIR /app

# The locked backend venv, copied root-owned (no --chown): the app user can run it but not rewrite its
# own code, and its bytecode is already compiled, so nothing is written at start-up.
COPY --from=py-builder /app/.venv /app/.venv

# Config is root-owned: the app user can read it but not rewrite it. alembic.ini is needed at
# runtime for migrations. No shell script ships: the launcher and the probe are Python modules.
COPY --chmod=644 alembic.ini /app/alembic.ini

# /app stays root-owned; only the dir the app writes (data, for the default SQLite database)
# belongs to the app user. Logs go to stdout, so there is no log directory.
COPY --from=py-builder --chown=10001:10001 /out/app/data /app/data

# Healthcheck: a Python probe (no curl, no shell); it uses HTTPS when HEALTHCHECK_SCHEME=https
ARG HEALTHCHECK_SCHEME=http
ENV HEALTHCHECK_SCHEME="${HEALTHCHECK_SCHEME:-http}"
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD ["/app/.venv/bin/python", "-m", "your_service_name.backend.healthcheck"]

USER 10001
ENV PATH="/app/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["/app/.venv/bin/python", "-m", "your_service_name.backend.serve"]
