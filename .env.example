# Local development settings: `cp .env.example .env`, then edit.
# Meanings and defaults: wiki/environment-variables.md (the reference). This file only lists the
# names. A line starting with "# " is optional and shows the default; uncomment it to override.
# Placeholders only: set a real value wherever you see change-me.

# --- General ---
# ENV=dev
# DEBUG=false
# LOG_LEVEL=INFO
# LOG_FORMAT=
# API_VERSION=v1
# API_TITLE=
# API_DESCRIPTION=
# API_DOCS_URL=/docs
# OPENAPI_URL=/openapi.json
# ALLOW_PRODUCTION_DOCS=false

# --- Backend ---
# BACKEND_ENTRY=your_service_name.backend.main:app
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# BACKEND_URL=
# BACKEND_BIND=
# BACKEND_KEEPALIVE_TIMEOUT=75
# BACKEND_GRACEFUL_TIMEOUT=30
# CUDA_VISIBLE_DEVICES=

# --- CORS ---
# CORS_ORIGINS=
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOW_METHODS=
# CORS_ALLOW_HEADERS=

# --- Auth ---
# AUTH_MODE=none
# ALLOW_ANONYMOUS=false
# AUTH_USER_ID_HEADER=x-authenticated-user-id
# AUTH_ROLES_HEADER=x-authenticated-user-roles
# AUTH_JWT_SECRET=change-me
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_USER_ID_CLAIM=sub
# AUTH_MODE=oidc (production): a JWT from an OpenID Connect provider, checked against its JWKS
# OIDC_ISSUER=https://idp.example.com
# OIDC_AUDIENCE=api://your-service
# OIDC_JWKS_URL=
# OIDC_ALGORITHMS=RS256,ES256
# OIDC_CLOCK_SKEW_SECONDS=60
# OIDC_USER_ID_CLAIM=sub
# OIDC_ROLES_CLAIM=
# AUTH_MODE=cloudflare-access (production, behind Cloudflare Access)
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=
# JWKS_CACHE_TTL_SECONDS=3600
# JWKS_MIN_REFETCH_SECONDS=30
# JWKS_MAX_STALE_SECONDS=86400

# --- Frontend ---
# FRONTEND_IMPL=react
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=3000
# FRONTEND_BIND=
# FRONTEND_REACT_SERVER=./frontend/.next/standalone/server.js
# FRONTEND_ROOT=./frontend
# NEXT_PUBLIC_API_URL=/api/v1

# --- NGINX ---
# NGINX_HOST=127.0.0.1
# NGINX_PORT=8081
# NGINX_BIND=
# NGINX_CONF=./infra/nginx/nginx.conf

# --- TLS ---
# TLS_CERT_PEM=
# EXTRA_CA_PEM=

# --- Database ---
# DB_PASSWORD is required: docker compose refuses to start without it. Set a real value.
DB_PASSWORD=change-me
# DB_USER=app
# DB_NAME=service_template
# Unset DATABASE_URL falls back to SQLite (SQLITE_PATH).
# DATABASE_URL=postgresql+asyncpg://app:change-me@<db-host>:<db-port>/service_template
# TEST_DATABASE_URL=
# SQLITE_PATH=
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_MIGRATION_LOCK_TIMEOUT_MS=10000
# DB_SSLMODE=disable
# DB_SSLROOTCERT=

# --- Logging ---
# LOG_DIR=./logs
# LOG_REQUESTS=false

# --- Rate limiting ---
# RATE_LIMIT_DEFAULT=100/minute

# --- Request limits ---
# MAX_REQUEST_BODY_BYTES=10485760
# ALLOWED_HOSTS=*

# --- Client IP (behind the gateway / Cloudflare Tunnel) ---
# TRUSTED_PROXY_CIDRS=
# TRUST_CF_CONNECTING_IP=false

# --- Runtime mode (local dev only) ---
# SERVICE_MODE=backend
