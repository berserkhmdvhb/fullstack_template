# infra/security/local/.env.local — per-developer overrides for the local
# supply-chain security runner (devsec.sh).
#
# This file is GITIGNORED: it holds machine- or developer-specific values and is
# NEVER committed. To customise, copy it:
#     cp infra/security/local/.env.local.example infra/security/local/.env.local
# Every key is OPTIONAL — when a key is absent (or the whole file is absent) the
# runner falls back to the git-derived default.
#
# Syntax: KEY=VALUE or `export KEY=VALUE`, one per line; values may be quoted.
# The file is PARSED, never sourced — shell code in a value is stored literally
# and never executed, so a value like TOKEN=$(rm -rf /) is harmless.

# --- Build coordinates (Task 2) ----------------------------------------------

# REGISTRY — override the local image registry.
# Default: ghcr.io.
#REGISTRY=ghcr.io

# GITHUB_REPOSITORY — override the <owner>/<repo> used for the local image
# (LOCAL_PROJECT; lowercased). Local images are tagged
# ${REGISTRY:-ghcr.io}/${GITHUB_REPOSITORY}/<id>:local-<short sha>.
# Default: derived from the git remote, e.g. owner/name.
#GITHUB_REPOSITORY=owner/name
