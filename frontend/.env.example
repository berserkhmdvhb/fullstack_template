# Frontend environment variables.
#
# Copy this file to `.env.local` and customize for your environment.
# `.env.local` is gitignored and should never be committed.
#
# All variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# Other variables are server-side only.

# =========================
# API Configuration
# =========================

# Base URL the BROWSER uses for API calls.
#
# Leave this as the default same-origin `/api/v1`: the browser fetches
# `/api/v1/...` from its own origin, and the Next.js server proxies those
# requests to the backend (see `rewrites()` in next.config.ts). Because the URL
# is relative, one built bundle works in every environment — the backend's
# location is supplied at deploy time by BACKEND_URL, not baked into the bundle.
#
# NEXT_PUBLIC_* is inlined at BUILD time, so do NOT point this at an absolute
# per-environment host: that would require rebuilding the image for each env.
# Set it only to override the default same-origin path.
NEXT_PUBLIC_API_URL=/api/v1

# Runtime proxy target: where the Next.js server forwards same-origin /api/v1,
# /docs, /openapi.json and /redoc calls. This is a *runtime* (server) env var,
# so it varies per environment from a single image:
#   - local `npm run dev`:   http://localhost:8000   (or your backend port)
#   - docker compose:        http://backend:8000
#   - kubernetes:            http://your-service-name-backend:8000  (via ConfigMap)
BACKEND_URL=http://localhost:8000

# =========================
# React Query Configuration
# =========================

# Number of retries for failed queries (default: 1).
# Set to 0 to disable retries.
NEXT_PUBLIC_QUERY_RETRY=1

# Time (in ms) before a query is considered stale (default: 30000 = 30s).
# While stale, cached data is shown immediately while a background refetch occurs.
NEXT_PUBLIC_QUERY_STALE_TIME=30000

# Time (in ms) before inactive queries are garbage collected (default: 300000 = 5min).
# Queries not observed by any component for this duration are removed from cache.
NEXT_PUBLIC_QUERY_GC_TIME=300000

# Whether to refetch queries when the browser window regains focus (default: false).
# Set to true to automatically refresh data when the user returns to the tab.
NEXT_PUBLIC_QUERY_REFETCH_ON_FOCUS=false

# =========================
# Logging
# =========================

# Log level: debug, info, warn, error (default: info).
# In production (NODE_ENV=production), debug messages are always suppressed.
LOG_LEVEL=info

# =========================
# Development
# =========================

# Port for `npm run dev` (default: 3000).
# Only used in development mode.
PORT=3000
