        "properties": {
          "source_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional source URL.",
            "title": "Source Url"
          },
          "text": {
            "description": "Text to echo.",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
