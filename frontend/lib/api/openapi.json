    "/api/v1/items": {
      "get": {
        "description": "List items with optional search filter and pagination.\n\nParameters\n----------\nsearch : str or None\n    Filter substring (case-insensitive ilike on name/description).\npage : int\n    Page number (1-indexed, default 1).\npage_size : int\n    Number of items per page (1-100, default 50).\nservice : ItemService\n    Injected dependency from centralized accessors.\n\nReturns\n-------\nItemListResponse\n    Paginated list of items with metadata.",
        "operationId": "list_items_api_v1_items_get",
        "parameters": [
          {
            "description": "Filter by name/description.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by name/description.",
              "title": "Search"
            }
          },
          {
            "description": "Page number (1-indexed).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page number (1-indexed).",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page.",
            "in": "query",
            "name": "page_size",
