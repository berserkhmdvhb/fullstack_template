    "/api/v1/health": {
      "get": {
        "description": "Readiness probe.\n\nReturns HTTP 200 ``{\"status\": \"ok\"}`` when the database is reachable and its schema revision is\nthis release's head, or one this release does not know (a newer release migrated first; ready,\nbecause migrations stay compatible with the previous release). Returns HTTP 503\n``{\"status\": \"degraded\", \"reason\": ...}`` otherwise, with ``reason`` one of\n``database_unreachable``, ``schema_missing`` (no version table or no row) or ``schema_behind``\n(an older, known revision). The body never names a revision, a URL or an error.\n\nThe check is read-only. The status code IS the contract: Kubernetes' readinessProbe keys off it,\nso a Pod that cannot serve is removed from the Service endpoints, and a rolling update keeps the\nold Pods serving until the migration Job has brought the schema to the new head. Liveness is\nseparate (/healthz) and never touches the database or the schema, so a Pod is never restarted\nfor waiting on a migration.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
