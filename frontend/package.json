{
  "name": "service-template-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run openapi-gen",
    "openapi-gen": "openapi-typescript ./lib/api/openapi.json --output ./lib/api/types.gen.d.ts",
    "format": "prettier . --write",
    "format-check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts --reporter default --reporter junit --outputFile=test-results/junit.xml",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter default --reporter junit --outputFile=test-results/junit-integration.xml",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^21.0.4",
    "jsdom": "^26.1.0",
    "msw": "^2.8.4",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss-selector-parser": "^6.1.5",
    "postcss": "^8.5.32",
    "vite": "^7.3.7"
  }
}
