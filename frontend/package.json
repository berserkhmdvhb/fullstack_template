{
  "name": "service-template-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prebuild": "npm run openapi-gen",
    "openapi-gen": "openapi-typescript ./lib/api/openapi.json --output ./lib/api/types.gen.d.ts",
    "format": "prettier . --write",
    "format-check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts --reporter default --reporter junit --outputFile=test-results/junit.xml",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter default --reporter junit --outputFile=test-results/junit-integration.xml",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter default --reporter junit --outputFile=test-results/junit-coverage.xml",
    "test:e2e": "playwright test",
    "test:a11y": "E2E_START_SERVER=1 playwright test e2e/a11y.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hookform/resolvers": "^7.0.8",
    "@lhci/cli": "0.16.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.5.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
